<?xml version="1.0" encoding="utf-8"?>

<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.preference.PreferenceCategory
        android:title="@string/excludes_title">

        <androidx.preference.Preference
            android:key="pref_blacklist_view"
            android:summary="@string/exclude_description"
            android:title="@string/pref_title_view_excludes"/>

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/includes_title">

        <androidx.preference.Preference
            android:key="pref_whitelist_view"
            android:summary="@string/include_description"
            android:title="@string/pref_title_view_includes"/>
    </androidx.preference.PreferenceCategory>

</androidx.preference.PreferenceScreen>